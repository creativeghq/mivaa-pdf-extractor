[Unit]
Description=Finish MIVAA maintenance after its reboot (#590)
After=network-online.target nginx.service mivaa-pdf-extractor.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /var/www/mivaa-pdf-extractor/scripts/maintenance/weekly.sh resume
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
